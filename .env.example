# Copy to .env and adjust before running `docker compose up -d`
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_DATABASE=martabak_pos
MYSQL_USER=pos
MYSQL_PASSWORD=changeme-pos

# Akun login pertama (dibuat sekali saat database belum punya user).
# Kalau ADMIN_PASSWORD kosong, password acak dicetak di: docker compose logs api
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme-admin
# Opsional — operator juga bisa dibuat admin dari menu "Pengguna".
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=changeme-operator

# Set true kalau aplikasi diakses lewat HTTPS
COOKIE_SECURE=false
