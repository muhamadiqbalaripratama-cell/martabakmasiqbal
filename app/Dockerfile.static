# Alternatif: build dist di mesin lokal/CI, lalu shipping image kecil.
# Pakai ini kalau VPS tidak boleh akses npm registry, atau Anda mau
# image final < 30 MB (multi-stage tetap perlu Node base image untuk build).
#
# Cara pakai:
#   npm install && npm run build
#   docker build -f Dockerfile.static -t martabak-pos:latest .

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html
EXPOSE 80
# 127.0.0.1, bukan localhost: di alpine localhost bisa ke ::1 (IPv6), nginx hanya listen IPv4.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
