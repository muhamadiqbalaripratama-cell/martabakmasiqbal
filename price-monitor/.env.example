# Salin ke .env lalu ganti semua password sebelum `docker compose up -d`
MYSQL_ROOT_PASSWORD=ganti-root
MYSQL_DATABASE=price_monitor
MYSQL_USER=monitor
MYSQL_PASSWORD=ganti-monitor

# Akun admin pertama (dibuat sekali saat database masih kosong).
# Kalau ADMIN_PASSWORD kosong, password acak dicetak di: docker compose logs api
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-admin

# Port website di VPS (default 8650) dan port MySQL lokal (default 3356)
WEB_PORT=8650
MYSQL_HOST_PORT=3356

# Set true kalau website diakses lewat HTTPS
COOKIE_SECURE=false

# Seberapa sering harga Binance & Hyperliquid diambil (detik, minimal 10)
PRICE_INTERVAL_SEC=20
# CoinGecko & harga emas diambil lebih jarang supaya tidak kena batas (detik, minimal 30)
COINGECKO_INTERVAL_SEC=60
# Berapa hari riwayat harga disimpan
HISTORY_DAYS=90

# Alamat API Binance. Kalau api.binance.com diblokir dari VPS, coba https://data-api.binance.vision
BINANCE_BASE_URL=https://api.binance.com

# API key CoinGecko (gratis, paket "Demo"): daftar di https://www.coingecko.com/en/api/pricing
# lalu buat key di Developer Dashboard. Dipakai untuk pencarian koin, logo, dan koin yang tidak ada
# di Binance/Hyperliquid. Kalau key-nya paket berbayar, ubah COINGECKO_PLAN=pro
COINGECKO_API_KEY=
COINGECKO_PLAN=demo

# Opsional: token Fonnte. Bisa juga diisi dari menu Admin → Pengaturan (yang di sana diutamakan).
FONNTE_TOKEN=
