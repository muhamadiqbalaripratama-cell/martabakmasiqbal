# Salin ke .env lalu ganti semua password sebelum `docker compose up -d`
MYSQL_ROOT_PASSWORD=ganti-root
MYSQL_DATABASE=price_monitor
MYSQL_USER=monitor
MYSQL_PASSWORD=ganti-monitor

# Akun admin pertama (dibuat sekali saat database masih kosong).
# Kalau ADMIN_PASSWORD kosong, password acak dicetak di: docker compose logs api
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-admin

# Port website di VPS (default 8650) dan port MySQL lokal (default 3356)
WEB_PORT=8650
MYSQL_HOST_PORT=3356

# Set true kalau website diakses lewat HTTPS
COOKIE_SECURE=false

# Seberapa sering harga diambil (detik, minimal 30) dan berapa hari riwayat disimpan
PRICE_INTERVAL_SEC=60
HISTORY_DAYS=90

# Opsional: API key "Demo" gratis dari https://www.coingecko.com/en/api (kuota lebih besar)
COINGECKO_API_KEY=

# Opsional: token Fonnte. Bisa juga diisi dari menu Admin → Pengaturan (yang di sana diutamakan).
FONNTE_TOKEN=
